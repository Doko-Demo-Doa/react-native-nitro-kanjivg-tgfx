{
  "name": "react-native-nitro-kanjivg-tgfx",
  "version": "0.1.0",
  "description": "Kanji drawing lib",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-nitro-kanjivg-tgfx-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "metro",
    "DATA-LICENSE.md",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "pnpm --filter react-native-nitro-kanjivg-tgfx-example",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "typecheck": "tsc",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "jest",
    "release": "release-it --only-version"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Doko-Demo-Doa/react-native-kanjivg-tgfx.git"
  },
  "author": "Quan Pham <doraemonfanclub@gmail.com> (https://github.com/Doko-Demo-Doa)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Doko-Demo-Doa/react-native-kanjivg-tgfx/issues"
  },
  "homepage": "https://github.com/Doko-Demo-Doa/react-native-kanjivg-tgfx#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.4",
    "@jest/globals": "^29.7.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@testing-library/react-native": "^14.1.0",
    "@types/react": "^19.2.0",
    "commitlint": "^21.2.4",
    "del-cli": "^8.0.1",
    "jest": "^29.7.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-builder-bob": "^0.44.1",
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "^0.13.1",
    "release-it": "^21.1.1",
    "test-renderer": "^1.3.1",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "^0.37.2",
    "react-native-reanimated": "*",
    "react-native-worklets": "*"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "pnpm@10.27.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "testEnvironmentOptions": {
      "customExportConditions": [
        "require",
        "react-native",
        "react-native-nitro-kanjivg-tgfx-source"
      ]
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "create-react-native-library": {
    "type": "lib",
    "tools": [
      "oxlint",
      "jest",
      "lefthook",
      "release-it"
    ],
    "version": "0.64.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ],
    "patchedDependencies": {
      "react-native-tgfx@0.2.0": "patches/react-native-tgfx@0.2.0.patch"
    }
  }
}
